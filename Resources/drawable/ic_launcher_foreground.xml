<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground — centred B mark on transparent background.
     Safe zone is the inner 66dp of 108dp, so all paths sit within that. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vertical spine (white) — centred in safe zone -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 32,22 H 46 V 86 H 32 Z"/>

    <!-- Upper lobe (blue) -->
    <path
        android:fillColor="#1C69D4"
        android:pathData="M 46,22 Q 88,22 88,42 Q 88,62 46,62 Z"/>

    <!-- Lower lobe (orange) -->
    <path
        android:fillColor="#E87C2C"
        android:pathData="M 46,64 Q 93,64 93,75 Q 93,86 46,86 Z"/>

</vector>
